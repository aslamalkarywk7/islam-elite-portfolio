{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/live/(.*)",
      "headers": [{ "key": "X-Frame-Options", "value": "ALLOWALL" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Frame-Options", "value": "ALLOWALL" }]
    }
  ]
}
